DNSServer dnsServer;

WiFiServer server(80);
Preferences prefs;
bool relayState = false;

int sleepStartMinutes = 1320; // 22:00
int sleepEndMinutes = 360;   // 06:00
bool sleepEnabled = true;
bool lastSleepActive = false;

String fmtTime(int m) {
  char buf[6];
  sprintf(buf, "%02d:%02d", m/60, m%60);
  return String(buf);
}

bool calcSleepActive(int current) {
  if (sleepStartMinutes < sleepEndMinutes)
    return current >= sleepStartMinutes && current < sleepEndMinutes;
  else
    return current >= sleepStartMinutes || current < sleepEndMinutes;
}

void setRelay(bool on) {
  relayState = on;
  digitalWrite(relayPin, on ? HIGH : LOW);
  prefs.putBool("relay", on);
}

void updateSleep() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return;
  int nowMin = timeinfo.tm_hour * 60 + timeinfo.tm_min;
  bool active = false;
  if (sleepEnabled) active = calcSleepActive(nowMin);
  if (active != lastSleepActive) {
    setRelay(!active);
    lastSleepActive = active;
  }
}

void setup() {
  Serial.begin(115200);
  prefs.begin("cfg", false);
  relayState = prefs.getBool("relay", false);
  pinMode(relayPin, OUTPUT);
  digitalWrite(relayPin, relayState ? HIGH : LOW);
  sleepStartMinutes = prefs.getInt("sleepStart", sleepStartMinutes);
  sleepEndMinutes = prefs.getInt("sleepEnd", sleepEndMinutes);
  sleepEnabled = prefs.getBool("sleepEnabled", sleepEnabled);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  dnsServer.start(53, "*", WiFi.softAPIP());
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi connected.");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());
  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());

  configTime(gmtOffset_sec, daylightOffset_sec, "pool.ntp.org");

  server.begin();
  updateSleep();
}

void loop() {
  dnsServer.processNextRequest();
  updateSleep();
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.reconnect();
    unsigned long start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < 10000) {
      delay(500);
      yield();
    }
  }
  WiFiClient client = server.available();
  if (client) {
    while (client.connected()) {
      yield();
      if (client.available()) {
        String req = client.readStringUntil('\r');
        client.read();

        if (req.indexOf("/SET_SLEEP") != -1) {
          int i = req.indexOf("start=");
          if (i != -1) sleepStartMinutes = req.substring(i + 6).toInt();
          i = req.indexOf("end=");
          if (i != -1) sleepEndMinutes = req.substring(i + 4).toInt();
          i = req.indexOf("enabled=");
          if (i != -1) sleepEnabled = req.substring(i + 8).toInt() == 1;
          updateSleep();
          prefs.putInt("sleepStart", sleepStartMinutes);
          prefs.putInt("sleepEnd", sleepEndMinutes);
          prefs.putBool("sleepEnabled", sleepEnabled);
        }

        if (req.indexOf("/ON") != -1) setRelay(true);
        if (req.indexOf("/OFF") != -1) setRelay(false);


